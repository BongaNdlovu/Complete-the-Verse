# Keep the Vercel deploy payload lean — the game ships only what the
# browser needs. Node tooling, local reports, content tooling and the
# unused backup audio never reach production.
.env
.env.*
node_modules/
audio/_orig_backup/
content/
docs/
plans/
test/
*.test.js
test.js
scripts/
*.md
.git/
.gitignore
.DS_Store
android/
android-standalone/
twa-manifest.json
